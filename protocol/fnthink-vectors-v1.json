  "_deliveryVocabulary": "delivery[].given 的 state / event 与 expect.state 只能取契约 delivery.states / delivery.events 里的值；expect.receipt 只能取契约 receipts 里的值。expect.ignored 的形状固定是 ignored:<state>+<event>，非空表示这一步什么都不做 —— 乱序与迟到是网络常态，抛错只会让调用方在错误处理里再造一个状态机。",
  "_deliveryCoverage": "expect 里出现的每条**迁移边**（state → 新 state，含自环）都必须覆盖契约 delivery.transitions 的全部允许边，一条不许少。少一条边的后果不是报错，而是那条状态在实现里没人测过 —— 而中间态意味着正文一直删不掉。",
  "delivery": [
    {
      "id": "d-dispatch",
      "given": {
        "state": "queued",
        "event": "dispatch",
        "attempts": 0,
        "hasBackupChannel": false
      },
      "expect": {
        "state": "delivering",
        "attempts": 1,
        "receipt": null,
        "deleteBody": false,
        "resend": null,
        "ignored": null
      },
      "note": "poll 取走：首次投递，尝试数 +1"
    },
    {
      "id": "d-ack-ok",
      "given": {
        "state": "delivering",
        "event": "ack_ok",
        "attempts": 1,
        "hasBackupChannel": false
      },
      "expect": {
        "state": "delivered",
        "attempts": 1,
        "receipt": "delivered",
        "deleteBody": true,
        "resend": null,
        "ignored": null
      },
      "note": "只有设备 ack 算送达；进终态必须立刻释放正文"
    },
    {
      "id": "d-retry-back-to-queued",
      "given": {
        "state": "delivering",
        "event": "ack_fail",
        "attempts": 1,
        "hasBackupChannel": false
      },
      "expect": {
        "state": "queued",
        "attempts": 1,
        "receipt": null,
        "deleteBody": false,
        "resend": null,
        "ignored": null
      },
      "note": "还有重试预算 ⇒ 回到 queued 等下一次 poll（服务端不能主动推，留在 delivering 自环就是卡死）"
    },
    {
      "id": "d-wait-no-backup",
      "given": {
        "state": "delivering",
        "event": "ack_fail",
        "attempts": 3,
        "hasBackupChannel": false
      },
      "expect": {
        "state": "waiting_online",
        "attempts": 3,
        "receipt": "waiting_online",
        "deleteBody": false,
        "resend": "queue_resend",
        "ignored": null
      },
      "note": "预算用满（1 次首投 + 2 次重试）⇒ waiting_online；没配备用渠道才由服务端排队补发"
    },
    {
      "id": "d-wait-with-backup",
      "given": {
        "state": "delivering",
        "event": "no_ack",
        "attempts": 3,
        "hasBackupChannel": true
      },
      "expect": {
        "state": "waiting_online",
        "attempts": 3,
        "receipt": "waiting_online",
        "deleteBody": false,
        "resend": "backup_replay",
        "ignored": null
      },
      "note": "同一件事的另一半：配了备用渠道就走备用补推，**绝不**两条并存（并存=提醒两次）"
    },
    {
      "id": "d-resend-on-online",
      "given": {
        "state": "waiting_online",
        "event": "peer_online",
        "attempts": 3,
        "hasBackupChannel": false
      },
      "expect": {
        "state": "delivering",
        "attempts": 1,
        "receipt": null,
        "deleteBody": false,
        "resend": null,
        "ignored": null
      },
      "note": "poll 即心跳：检测到上线立刻补发。**尝试数按「投递轮次」算** —— 转 waiting_online 已经结束了上一轮，补发是新一轮，所以这里回到 1；若把预算算成全局的，waiting_online 就成了死路（永远发不出去），与 §1 那张图直接矛盾"
    },
    {
      "id": "d-expired-queued",
      "given": {
        "state": "queued",
        "event": "ttl_elapsed",
        "attempts": 0,
        "hasBackupChannel": false
      },
      "expect": {
        "state": "expired",
        "attempts": 0,
        "receipt": "expired",
        "deleteBody": true,
        "resend": null,
        "ignored": null
      },
      "note": "排队超 7 天 ⇒ expired，正文与状态一起走"
    },
    {
      "id": "d-expired-delivering",
      "given": {
        "state": "delivering",
        "event": "ttl_elapsed",
        "attempts": 2,
        "hasBackupChannel": false
      },
      "expect": {
        "state": "expired",
        "attempts": 2,
        "receipt": "expired",
        "deleteBody": true,
        "resend": null,
        "ignored": null
      },
      "note": "在飞的那条也会到期（否则它永远停在 delivering）"
    },
    {
      "id": "d-expired-waiting",
      "given": {
        "state": "waiting_online",
        "event": "ttl_elapsed",
        "attempts": 3,
        "hasBackupChannel": false
      },
      "expect": {
        "state": "expired",
        "attempts": 3,
        "receipt": "expired",
        "deleteBody": true,
        "resend": null,
        "ignored": null
      },
      "note": "补发等到期 ⇒ 告知发送端 + 删正文"
    },
    {
      "id": "d-evicted",
      "given": {
        "state": "queued",
        "event": "evicted",
        "attempts": 0,
        "hasBackupChannel": false
      },
      "expect": {
        "state": "dropped",
        "attempts": 0,
        "receipt": "dropped",
        "deleteBody": true,
        "resend": null,
        "ignored": null
      },
      "note": "被 200 条上限挤位：dropped 也是终态，**必须**同样释放正文（契约第一版漏的就是这一条）"
    },
    {
      "id": "d-dispatch-budget-spent",
      "given": {
        "state": "queued",
        "event": "dispatch",
        "attempts": 3,
        "hasBackupChannel": false
      },
      "expect": {
        "state": "waiting_online",
        "attempts": 3,
        "receipt": "waiting_online",
        "deleteBody": false,
        "resend": "queue_resend",
        "ignored": null
      },
      "note": "尝试数已用满时 poll 取走不该再投一次，直接转 waiting_online"
    },
    {
      "id": "d-dispatch-last-attempt",
      "given": {
        "state": "queued",
        "event": "dispatch",
        "attempts": 2,
        "hasBackupChannel": false
      },
      "expect": {
        "state": "delivering",
        "attempts": 3,
        "receipt": null,
        "deleteBody": false,
        "resend": null,
        "ignored": null
      },
      "note": "契约的 deliveryRetryTotal=2 指的是**首次之外**再试 2 次 ⇒ 总共 3 次尝试；这一例把「第 3 次还允许发」钉住，两边若把 2 当成总次数，这里就分叉"
    },
    {
      "id": "d-ack-before-dispatch",
      "given": {
        "state": "queued",
        "event": "ack_ok",
        "attempts": 0,
        "hasBackupChannel": false
      },
      "expect": {
        "state": "queued",
        "attempts": 0,
        "receipt": null,
        "deleteBody": false,
        "resend": null,
        "ignored": "ignored:queued+ack_ok"
      },
      "note": "迟到的 ack（这条还没发出去）⇒ 忽略，状态不动"
    },
    {
      "id": "d-terminal-ack",
      "given": {
        "state": "delivered",
        "event": "ack_ok",
        "attempts": 1,
        "hasBackupChannel": false
      },
      "expect": {
        "state": "delivered",
        "attempts": 1,
        "receipt": null,
        "deleteBody": false,
        "resend": null,
        "ignored": "ignored:delivered+ack_ok"
      },
      "note": "终态收到重复 ack ⇒ 忽略（终态没有出边，迁移表与实现同一口径）"
    },
    {
      "id": "d-terminal-ttl",
      "given": {
        "state": "dropped",
        "event": "ttl_elapsed",
        "attempts": 0,
        "hasBackupChannel": false
      },
      "expect": {
        "state": "dropped",
        "attempts": 0,
        "receipt": null,
        "deleteBody": false,
        "resend": null,
        "ignored": "ignored:dropped+ttl_elapsed"
      },
      "note": "终态不会被到期改写（否则正文释放条件会被绕开）"
    },
    {
      "id": "d-dispatch-while-waiting",
      "given": {
        "state": "waiting_online",
        "event": "dispatch",
        "attempts": 2,
        "hasBackupChannel": false
      },
      "expect": {
        "state": "waiting_online",
        "attempts": 2,
        "receipt": null,
        "deleteBody": false,
        "resend": null,
        "ignored": "ignored:waiting_online+dispatch"
      },
      "note": "waiting_online 只能由 peer_online 重发：poll 取走这条路不该走通"
    },
    {
      "id": "d-evicted-inflight",
      "given": {
        "state": "delivering",
        "event": "evicted",
        "attempts": 1,
        "hasBackupChannel": false
      },
      "expect": {
        "state": "delivering",
        "attempts": 1,
        "receipt": null,
        "deleteBody": false,
        "resend": null,
        "ignored": "ignored:delivering+evicted"
      },
      "note": "已经在飞的那条不挤位（挤它等于丢一条用户可能已经看到的消息）"
    }
  ],
  "_backupReplayWhy": "T46：delivery.advance 的步里只回答「该走哪条路」（路线词），而路线词之后的三件事 —— 能不能再补推一次（幂等键）、最多补推几次（上限）、这一发在记录上叫什么（标签）—— 今天在代码里没有第二份答案。三样都写在契约里，所以三样都由这份向量钉住，两端各断言一遍。⇒ 这一组的重点不是各行分别对不对，而是**互斥**：backup_replay 与 queue_resend 永远只出现一个（两条并存 = 同一条消息提醒两次）。",
  "backupReplay": [
    {
      "id": "br-queue-resend",
      "given": {
        "route": "queue_resend",
        "alreadyReplayed": false,
        "replayCount": 0,
        "messageId": "msg-1"
      },
      "expect": {
        "action": "queue_resend",
        "label": null,
        "dedupeKey": null,
        "limitReason": null
      },
      "note": "没配备用渠道 ⇒ 交服务端排队补发，发送端**不动作**。这一行是互斥的正面说法：调用方不必自己判 「有没有备用」（那是第二份判据）"
    },
    {
      "id": "br-queue-resend-after-replay",
      "given": {
        "route": "queue_resend",
        "alreadyReplayed": true,
        "replayCount": 3,
        "messageId": "msg-1"
      },
      "expect": {
        "action": "queue_resend",
        "label": null,
        "dedupeKey": null,
        "limitReason": null
      },
      "note": "幂等键与补推上限**只管补推那一档**：已经补推过不该把排队补发也一起压掉（压掉的后果是这条消息再没有投递路径）"
    },
    {
      "id": "br-replay-first",
      "given": {
        "route": "backup_replay",
        "alreadyReplayed": false,
        "replayCount": 0,
        "messageId": "msg-2"
      },
      "expect": {
        "action": "backup_replay",
        "label": "\u5907\u7528\u8865\u63a8",
        "dedupeKey": "msg-2",
        "max": 2,
        "limitReason": null
      },
      "note": "配了备用渠道 ⇒ 走备用补推；去重键就是这条的 message_id（契约 waitingOnline.backupReplayIdempotencyKey）"
    },
    {
      "id": "br-replay-second",
      "given": {
        "route": "backup_replay",
        "alreadyReplayed": false,
        "replayCount": 1,
        "messageId": "msg-2"
      },
      "expect": {
        "action": "backup_replay",
        "label": "\u5907\u7528\u8865\u63a8",
        "dedupeKey": "msg-2",
        "max": 2,
        "limitReason": null
      },
      "note": "上限是 2 ⇒ 还有一次可补推（把上限读成 1 的实现会在这一行红）"
    },
    {
      "id": "br-replay-cap",
      "given": {
        "route": "backup_replay",
        "alreadyReplayed": false,
        "replayCount": 2,
        "messageId": "msg-2"
      },
      "expect": {
        "action": "none",
        "label": null,
        "dedupeKey": null,
        "limitReason": "cap-reached"
      },
      "note": "补推次数用满 ⇒ 什么都不做（契约 limits.backupReplayMax = 2）"
    },
    {
      "id": "br-replay-over-cap",
      "given": {
        "route": "backup_replay",
        "alreadyReplayed": false,
        "replayCount": 5,
        "messageId": "msg-2"
      },
      "expect": {
        "action": "none",
        "label": null,
        "dedupeKey": null,
        "limitReason": "cap-reached"
      },
      "note": "上限判据必须写成 >= 而不是 ==：写成 == 的话计数一旦越过上限就一路补推下去（账是从别处读来的，越界是常态）"
    },
    {
      "id": "br-replay-idempotent",
      "given": {
        "route": "backup_replay",
        "alreadyReplayed": true,
        "replayCount": 1,
        "messageId": "msg-2"
      },
      "expect": {
        "action": "none",
        "label": null,
        "dedupeKey": null,
        "limitReason": "already-replayed"
      },
      "note": "同一个 message_id 已经补推过 ⇒ 幂等，不许再来一次"
    },
    {
      "id": "br-replay-idempotent-before-cap",
      "given": {
        "route": "backup_replay",
        "alreadyReplayed": true,
        "replayCount": 2,
        "messageId": "msg-2"
      },
      "expect": {
        "action": "none",
        "label": null,
        "dedupeKey": null,
        "limitReason": "already-replayed"
      },
      "note": "幂等**先于**上限判：两者同时成立时报幂等，因为 「这条已经补推过」才是这次不动作的直接原因，而上限用满是另一条消息的事"
    }
  ],
  "titleEnvelope": {
    "_why": "设备这一路的标题信封（契约 deviceSend.titleEnvelope）。同一份表，Dart 与 Node 各断自己那一半：Dart 断「这一串是编码规则算出来的」与「收件端拆出来就是 appliedTitle/appliedBody」；Node 断「服务端把 wireBody 当一段不透明正文：存进去什么、poll 回来还是什么，而标题列永远是空的」。",
    "_serverTitleWhy": "expect.serverTitle 全表都是空串，这不是遗漏：canonicalOrder 里没有 title，而服务端只收出现在已签字节里的标题。哪天它开始自己拆信封，这一列就不再是空的，而同一条消息在两台设备上会有两种表现 —— 那正是 splitBy=receiving-client 要防的。",
    "_appliedBodyWhy": "expect.appliedBody 是收件端最终显示的那一份正文。拆不出来时它等于整段 wireBody（前缀也留着）：这是刻意的 —— 「猜一个标题出来并把前缀抹掉」与「原样显示」相比，后者至少让用户看得见那串到底是什么。",
    "rows": [
      {
        "id": "te-plain",
        "given": {
          "title": "客厅温度",
          "body": "30℃，请检查空调"
        },
        "expect": {
          "wireBody": "fnthink-title:v1{\"t\":\"客厅温度\",\"b\":\"30℃，请检查空调\"}",
          "serverTitle": "",
          "serverBody": "fnthink-title:v1{\"t\":\"客厅温度\",\"b\":\"30℃，请检查空调\"}",
          "split": true,
          "appliedTitle": "客厅温度",
          "appliedBody": "30℃，请检查空调"
        },
        "note": "最常见的一行：标题与正文各归各位，线上是一串带前缀的紧凑 JSON"
      },
      {
        "id": "te-empty-title",
        "given": {
          "title": "",
          "body": "只有正文一行"
        },
        "expect": {
          "wireBody": "只有正文一行",
          "serverTitle": "",
          "serverBody": "只有正文一行",
          "split": false,
          "appliedTitle": "",
          "appliedBody": "只有正文一行"
        },
        "note": "没有标题就【不套信封】：套了会留下「有信封而标题为空」这一形状，它与「本来就没有标题」拆完之后不可区分"
      },
      {
        "id": "te-title-with-newline",
        "given": {
          "title": "巡检\n第 2 层",
          "body": "全部正常"
        },
        "expect": {
          "wireBody": "fnthink-title:v1{\"t\":\"巡检\\n第 2 层\",\"b\":\"全部正常\"}",
          "serverTitle": "",
          "serverBody": "fnthink-title:v1{\"t\":\"巡检\\n第 2 层\",\"b\":\"全部正常\"}",
          "split": true,
          "appliedTitle": "巡检\n第 2 层",
          "appliedBody": "全部正常"
        },
        "note": "标题里本来就有换行 —— 这一行就是「为什么不用换行当分隔」的证据：用分隔符会在这一刻丢信息"
      },
      {
        "id": "te-title-with-quote-and-backslash",
        "given": {
          "title": "他说\"好\" \\ C:\\temp",
          "body": "正文里也有\"引号\"与 \\ 反斜杠"
        },
        "expect": {
          "wireBody": "fnthink-title:v1{\"t\":\"他说\\\"好\\\" \\\\ C:\\\\temp\",\"b\":\"正文里也有\\\"引号\\\"与 \\\\ 反斜杠\"}",
          "serverTitle": "",
          "serverBody": "fnthink-title:v1{\"t\":\"他说\\\"好\\\" \\\\ C:\\\\temp\",\"b\":\"正文里也有\\\"引号\\\"与 \\\\ 反斜杠\"}",
          "split": true,
          "appliedTitle": "他说\"好\" \\ C:\\temp",
          "appliedBody": "正文里也有\"引号\"与 \\ 反斜杠"
        },
        "note": "引号与反斜杠：JSON 转义必须原样回来，否则收件端拆出来的是半个标题"
      },
      {
        "id": "te-emoji",
        "given": {
          "title": "🔥 高温告警",
          "body": "机房 80℃ 🧯"
        },
        "expect": {
          "wireBody": "fnthink-title:v1{\"t\":\"🔥 高温告警\",\"b\":\"机房 80℃ 🧯\"}",
          "serverTitle": "",
          "serverBody": "fnthink-title:v1{\"t\":\"🔥 高温告警\",\"b\":\"机房 80℃ 🧯\"}",
          "split": true,
          "appliedTitle": "🔥 高温告警",
          "appliedBody": "机房 80℃ 🧯"
        },
        "note": "非 ASCII 与代理对：两端都不许把它们变成别的字符"
      },
      {
        "id": "te-claimed-top-level-title",
        "given": {
          "title": "温度告警",
          "body": "机箱温度 63℃",
          "claimedTopLevelTitle": "温度告警"
        },
        "expect": {
          "wireBody": "fnthink-title:v1{\"t\":\"温度告警\",\"b\":\"机箱温度 63℃\"}",
          "serverTitle": "",
          "serverBody": "fnthink-title:v1{\"t\":\"温度告警\",\"b\":\"机箱温度 63℃\"}",
          "split": true,
          "appliedTitle": "温度告警",
          "appliedBody": "机箱温度 63℃"
        },
        "note": "§4-10 那一行：设备在顶层另附一个未签 title，服务端【一定】丢掉它（整段比对），而标题仍然到达收件端 —— 因为它在已签的 body 信封里"
      },
      {
        "id": "te-prefix-but-not-json",
        "given": {
          "wireBody": "fnthink-title:v1这不是 JSON"
        },
        "expect": {
          "wireBody": "fnthink-title:v1这不是 JSON",
          "serverTitle": "",
          "serverBody": "fnthink-title:v1这不是 JSON",
          "split": false,
          "appliedTitle": "",
          "appliedBody": "fnthink-title:v1这不是 JSON"
        },
        "note": "前缀后面不是 JSON ⇒ 整段当正文（【不猜】）。表现是标题没了，而不是把别人的正文升级成标题"
      },
      {
        "id": "te-prefix-missing-body-key",
        "given": {
          "wireBody": "fnthink-title:v1{\"t\":\"只有标题\"}"
        },
        "expect": {
          "wireBody": "fnthink-title:v1{\"t\":\"只有标题\"}",
          "serverTitle": "",
          "serverBody": "fnthink-title:v1{\"t\":\"只有标题\"}",
          "split": false,
          "appliedTitle": "",
          "appliedBody": "fnthink-title:v1{\"t\":\"只有标题\"}"
        },
        "note": "缺 bodyKey ⇒ 不算合法信封，整段当正文：宁可少一个标题，也不把半截信封显示给用户"
      },
      {
        "id": "te-signed-title-wins",
        "given": {
          "wireBody": "fnthink-title:v1{\"t\":\"信封标题\",\"b\":\"信封正文\"}",
          "signedTitleFromServer": "已签标题"
        },
        "expect": {
          "wireBody": "fnthink-title:v1{\"t\":\"信封标题\",\"b\":\"信封正文\"}",
          "serverTitle": "",
          "serverBody": "fnthink-title:v1{\"t\":\"信封标题\",\"b\":\"信封正文\"}",
          "split": false,
          "appliedTitle": "已签标题",
          "appliedBody": "fnthink-title:v1{\"t\":\"信封标题\",\"b\":\"信封正文\"}"
        },
        "note": "已签的标题是权威的：非空时信封【不许】盖掉它（未签内容覆盖已签内容是本协议反复拒的那件事）"
      }
    ]
  }
}
