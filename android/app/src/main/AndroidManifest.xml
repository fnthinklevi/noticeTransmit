                <action android:name="com.fnthink.notice.action.RESUME_PUSH" />
            </intent-filter>
        </receiver>

        <!-- 桌面小部件：一键开启/暂停推送服务 -->
        <!-- exported=true：APPWIDGET_UPDATE / APPWIDGET_ENABLED 等广播由系统 AppWidget 服务从外部发送 -->
        <receiver
            android:name=".PushToggleWidgetProvider"
            android:enabled="true"
            android:exported="true"
            android:label="推送开关">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.fnthink.notice.widget.TOGGLE_PUSH" />
                <action android:name="com.fnthink.notice.widget.UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/push_toggle_widget_info" />
        </receiver>

        <!-- 4×2 宽规格：与 2×2 共用布局自适应逻辑，独立注册以在桌面列表中提供两种规格 -->
        <receiver
            android:name=".PushToggleWidgetWideProvider"
            android:enabled="true"
            android:exported="true"
            android:label="推送开关(4×2)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.fnthink.notice.widget.TOGGLE_PUSH" />
                <action android:name="com.fnthink.notice.widget.UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/push_toggle_widget_wide_info" />
        </receiver>

