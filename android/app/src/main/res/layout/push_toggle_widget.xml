<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小部件 2×2 紧凑布局（推送开关）
  视觉层级：顶部标题（左上，背景含右上角状态点）→ 中央状态圆 → 底部提示胶囊
  颜色体系与应用一致（iOS 风格：蓝 #007AFF / 绿 #34C759 / 红 #FF3B30），明暗桌面下均可读
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_active"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <!-- 左上角标题（跟随语言切换，运行时由 I18n 覆盖） -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:maxWidth="110dp"
        android:text="通知推送助手"
        android:textColor="#3C3C43"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- 中央状态圆（推送=绿 / 暂停=红，圆内状态文字；渐变+白描边+高光） -->
    <TextView
        android:id="@+id/widget_circle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_circle_active"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:shadowColor="#26000000"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:text="推送中"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- 底部提示（胶囊样式） -->
    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/widget_pill_hint"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:maxWidth="110dp"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp"
        android:text="点击暂停推送"
        android:textColor="#6E6E73"
        android:textSize="10sp" />

</FrameLayout>
