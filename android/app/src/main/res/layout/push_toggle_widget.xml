<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小部件 2×2 紧凑布局（推送状态 + 一键暂停/恢复）

  版式取自成熟小组件的共同做法：**一张纯色容器 + 三段层级**
    ① 顶部 图标 + 应用名（弱色、小字，回答"这是谁"）
    ② 中段 状态大字（强色，一眼可读，22sp 在桌面距离下才认得出）
    ③ 底部 一行动作提示（弱色，回答"我能干什么 / 发生了什么事"）
  原先是"浅绿卡片 + 中间一个 56dp 圆塞 11sp 字"：圆里的字太小看不清，
  颜色又是近乎白的浅绿 —— 桌上一扫而过等于没有状态。现在整张卡片就是状态色。

  文字颜色不写在这里：三态各有各的 onContainer / accent，由
  PushToggleWidgetProvider 按状态 setTextColor（@color + values-night 双份，深浅桌面都够对比度）。
  tools:ignore 只用于预览占位文案 —— 运行时每个 TextView 都会被 I18n 覆盖。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_active"
    android:baselineAligned="false"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- ① 品牌行：图标 + 应用名 -->
    <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/widget_ic_pushing"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="通知推送助手"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText,UseCompatTextViewDrawableXml" />

    <!-- ② 状态大字（推送中 / 已暂停 / 已关闭） -->
    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="推送中"
        android:textSize="24sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

    <!-- ③ 动作提示 / 已关闭时说明原因与下一步 -->
    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="点击暂停推送"
        android:textSize="12sp"
        tools:ignore="HardcodedText" />
</LinearLayout>
