<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小部件 4×2 宽布局（推送开关 + 当日推送计数）
  视觉层级：顶部标题 → 左侧状态圆 + 右侧当日计数面板 → 底部提示胶囊
  颜色体系与应用一致（iOS 风格），明暗桌面下均可读
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_active"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <!-- 左上角标题（跟随语言切换，运行时由 I18n 覆盖） -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:text="通知推送助手"
        android:textColor="#3C3C43"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- 内容区：左侧状态圆 + 右侧当日推送数量面板 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 左半：圆形状态 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_circle"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/widget_circle_active"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="#26000000"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="推送中"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 右半：当日已推送通知数量（数据面板） -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:layout_marginStart="12dp"
            android:background="@drawable/widget_panel_count"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/widget_daily_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:text="当日已推送"
                android:textColor="#8E8E93"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_daily_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0"
                android:textColor="#007AFF"
                android:textSize="27sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部提示（胶囊样式） -->
    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/widget_pill_hint"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="3dp"
        android:paddingEnd="12dp"
        android:paddingBottom="3dp"
        android:text="点击暂停/恢复推送"
        android:textColor="#6E6E73"
        android:textSize="10sp" />

</FrameLayout>
