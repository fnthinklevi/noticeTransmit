<?xml version="1.0" encoding="utf-8"?>
<!--
  选择器预览（Android 11 及以下用 previewImage；12+ 直接渲染 previewLayout）。
  与运行时同一套语言：绿色容器 + 三段层级（品牌行 / 状态大字 / 提示行），
  用几条半透明色块示意文字位置 —— 预览图里不放真实文案，免得换语言时预览是中文。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/widget_pushing_container" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_pushing_outline" />
        </shape>
    </item>

    <!-- 品牌行：图标位 + 一行短色块 -->
    <item
        android:left="16dp"
        android:top="14dp"
        android:width="16dp"
        android:height="16dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_pushing_on" />
        </shape>
    </item>
    <item
        android:left="38dp"
        android:top="18dp"
        android:width="52dp"
        android:height="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#590B3D1A" />
        </shape>
    </item>

    <!-- 状态大字 -->
    <item
        android:left="16dp"
        android:top="46dp"
        android:width="86dp"
        android:height="22dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/widget_pushing_on" />
        </shape>
    </item>

    <!-- 提示行 -->
    <item
        android:left="16dp"
        android:top="96dp"
        android:width="68dp"
        android:height="10dp">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="#590B3D1A" />
        </shape>
    </item>
</layer-list>
