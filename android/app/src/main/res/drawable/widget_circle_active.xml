<?xml version="1.0" encoding="utf-8"?>
<!-- 推送中圆形：柔和光晕 + 白色描边环 + 绿色渐变主体 + 顶部玻璃高光 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底部柔和光晕 -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="oval">
            <solid android:color="#2E4CD964" />
        </shape>
    </item>

    <!-- 白色描边环 -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- 主体：绿色渐变（左上亮 → 右下暗） -->
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#61E284"
                android:endColor="#2FB652"
                android:type="linear" />
        </shape>
    </item>

    <!-- 顶部玻璃高光 -->
    <item
        android:bottom="30dp"
        android:left="10dp"
        android:right="10dp"
        android:top="9dp">
        <shape android:shape="oval">
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
