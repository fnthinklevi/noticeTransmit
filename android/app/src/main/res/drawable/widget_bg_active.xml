<?xml version="1.0" encoding="utf-8"?>
<!-- 推送中：整张卡片是绿色容器（Material 3 有色容器做法），描边收边、无投影。
     状态不再靠"右上角一个小圆点"表达 —— 桌面图标旁边那点像素在真实使用里看不见，
     颜色本身就是状态，配合文字与图标三通道一起说同一件事。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <solid android:color="@color/widget_pushing_container" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_pushing_outline" />
</shape>
