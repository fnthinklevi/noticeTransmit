<?xml version="1.0" encoding="utf-8"?>
<!-- 推送中背景：浅绿柔和渐变卡片 + 1dp 细边框 + 底部投影 + 右上角绿色状态点（iOS 风格） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 投影层：模拟卡片浮起（右侧/底部略重） -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#3327AE60" />
        </shape>
    </item>

    <!-- 主卡片：浅绿 → 浅绿渐变 + 细边框 -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="2dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="315"
                android:startColor="#F2FBF5"
                android:endColor="#DFF4E7"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#B8E6C8" />
        </shape>
    </item>

    <!-- 右上角状态指示点（推送中 = 绿色，白色描边） -->
    <item
        android:gravity="top|end"
        android:top="12dp"
        android:right="12dp">
        <shape android:shape="oval">
            <size
                android:width="9dp"
                android:height="9dp" />
            <gradient
                android:angle="315"
                android:startColor="#4CD964"
                android:endColor="#2FB652"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#B3FFFFFF" />
        </shape>
    </item>
</layer-list>
