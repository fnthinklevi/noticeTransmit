<?xml version="1.0" encoding="utf-8"?>
<!-- 卡片内浮层（计数面板）：半透明黑叠加，三态容器上都能用，
     不必为每一态再配一个白色面板（深色桌面改用半透明白，见 values-night）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <solid android:color="@color/widget_overlay_soft" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_overlay_line" />
</shape>
