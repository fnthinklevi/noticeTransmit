<?xml version="1.0" encoding="utf-8"?>
<!--
  4×2 小部件选择器预览图（Android 11 及以下系统选择器使用 previewImage 显示）
  模拟运行时外观：绿色卡片 + 左侧状态圆 + 右侧当日计数面板 + 底部提示胶囊（无文字）
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 卡片背景（绿色渐变 + 边框） -->
    <item
        android:bottom="2dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="315"
                android:startColor="#F4FBF6"
                android:endColor="#E2F5E9"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#C5E9D2" />
        </shape>
    </item>

    <!-- 右上角绿色状态点（白底 + 绿心） -->
    <item
        android:width="12dp"
        android:height="12dp"
        android:gravity="top|end"
        android:right="16dp"
        android:top="12dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item
        android:width="8dp"
        android:height="8dp"
        android:gravity="top|end"
        android:right="18dp"
        android:top="14dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#4CD964"
                android:endColor="#2FB652"
                android:type="linear" />
        </shape>
    </item>

    <!-- 左侧状态圆（白色描边环 + 绿色渐变主体） -->
    <item
        android:width="62dp"
        android:height="62dp"
        android:gravity="start|center_vertical"
        android:left="40dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item
        android:width="54dp"
        android:height="54dp"
        android:gravity="start|center_vertical"
        android:left="44dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#61E284"
                android:endColor="#2FB652"
                android:type="linear" />
        </shape>
    </item>

    <!-- 右侧计数面板 -->
    <item
        android:width="130dp"
        android:height="60dp"
        android:gravity="end|center_vertical"
        android:right="36dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#66FFFFFF"
                android:endColor="#40FFFFFF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#2E8E8E93" />
        </shape>
    </item>

    <!-- 底部提示胶囊 -->
    <item
        android:width="140dp"
        android:height="18dp"
        android:gravity="bottom|center_horizontal"
        android:bottom="12dp">
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="#A6FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#1F3C3C43" />
        </shape>
    </item>
</layer-list>
