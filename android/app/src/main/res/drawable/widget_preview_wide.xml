<?xml version="1.0" encoding="utf-8"?>
<!-- 选择器预览（4×2）：左=三段层级，右=计数面板。与运行时同一套语言，不放真实文案。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/widget_pushing_container" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_pushing_outline" />
        </shape>
    </item>

    <!-- 左：品牌行 -->
    <item
        android:left="16dp"
        android:top="16dp"
        android:width="14dp"
        android:height="14dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_pushing_on" />
        </shape>
    </item>
    <item
        android:left="36dp"
        android:top="19dp"
        android:width="58dp"
        android:height="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#590B3D1A" />
        </shape>
    </item>
    <!-- 左：状态大字 -->
    <item
        android:left="16dp"
        android:top="42dp"
        android:width="78dp"
        android:height="20dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/widget_pushing_on" />
        </shape>
    </item>
    <!-- 左：提示行 -->
    <item
        android:left="16dp"
        android:top="70dp"
        android:width="62dp"
        android:height="9dp">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="#590B3D1A" />
        </shape>
    </item>

    <!-- 右：计数面板 -->
    <item
        android:right="16dp"
        android:top="16dp"
        android:bottom="16dp"
        android:width="86dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/widget_overlay_soft" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_overlay_line" />
        </shape>
    </item>
    <item
        android:right="52dp"
        android:top="34dp"
        android:width="30dp"
        android:height="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#590B3D1A" />
        </shape>
    </item>
    <item
        android:right="44dp"
        android:top="50dp"
        android:width="46dp"
        android:height="24dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <solid android:color="@color/widget_pushing_on" />
        </shape>
    </item>
</layer-list>
