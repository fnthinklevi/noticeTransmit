<?xml version="1.0" encoding="utf-8"?>
<!-- 暂停背景：浅灰柔和渐变卡片 + 细边框 + 底部投影 + 右上角红色状态点（iOS 风格） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 投影层：模拟卡片浮起（右侧/底部略重） -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#243C3C43" />
        </shape>
    </item>

    <!-- 主卡片：浅灰渐变 + 细边框 -->
    <item
        android:bottom="2dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="315"
                android:startColor="#F9F9FB"
                android:endColor="#EEEFF3"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#DCDDE3" />
        </shape>
    </item>

    <!-- 右上角状态指示点（暂停 = 红色，白色描边） -->
    <item
        android:gravity="top|end"
        android:right="10dp"
        android:top="10dp">
        <shape android:shape="oval">
            <size
                android:width="10dp"
                android:height="10dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item
        android:gravity="top|end"
        android:right="12dp"
        android:top="12dp">
        <shape android:shape="oval">
            <size
                android:width="6dp"
                android:height="6dp" />
            <gradient
                android:angle="315"
                android:startColor="#FF6B5E"
                android:endColor="#E02D22"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
