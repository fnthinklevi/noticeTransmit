<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- debug 的启动入口是 .MainActivity（集成测试需要 activity 级 LAUNCHER），
         故禁用默认 alias，避免桌面同时出现 activity 与 alias 两个图标。
         注：调试期若手动切换过桌面图标，IconService 会启用对应 alias，此时仍可能出现两个入口——
         仅影响 debug 包，不影响线上。 -->
    <application>
        <activity-alias
            android:name=".LauncherDefaultZh"
            android:enabled="false"
            tools:node="merge"
            tools:replace="android:enabled" />

        <!-- 真机读数工装（仅 debug 变体，release/profile 清单不含它）。
             这台 MIUI（2410DPN6CC / Android 17）对 shell 与 UiAutomation 都收回
             INJECT_EVENTS，`adb shell input` 不可用；而系统允许在 secure settings 里
             启用一个无障碍服务，无障碍连接可以 dispatchGesture —— 这是不 root 的前提下
             唯一能自动驱动页面的路。命令走应用外部目录里的 ui_cmd.txt，只在测试包
             （-PnoticeTestAppIdSuffix 改出的 applicationId）上启用。 -->
        <service
            android:name=".DevUiAccessibilityService"
            android:enabled="true"
            android:exported="true"
            android:label="Dev UI driver"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/dev_ui_accessibility" />
        </service>
    </application>
</manifest>
