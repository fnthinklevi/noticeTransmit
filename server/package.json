{
  "name": "notification-update-server",
  "version": "1.0.0",
  "description": "通知推送助手 - 版本更新服务端",
  "engines": {
    "node": ">=24"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "jest --verbose",
    "format": "prettier --write \"lib/**/*.js\" server.js \"test/**/*.js\"",
    "format:check": "prettier --check \"lib/**/*.js\" server.js \"test/**/*.js\""
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(@scure|@noble)/)"
    ]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "otplib": "^13.0.1",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "jest": "^29.7.0",
    "prettier": "^3.9.8",
    "supertest": "^7.0.0"
  }
}
