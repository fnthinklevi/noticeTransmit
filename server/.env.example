# 通知推送助手 - 服务端环境变量模板
# 复制本文件为 .env 并在部署机上填写真实值。
# 注意：.env 已被 .gitignore 忽略，切勿将含真实密钥的 .env 提交到仓库。

# 服务监听端口
PORT=3456

# 管理员登录 Token 的 bcrypt 哈希（非明文密码）。
# 生成方式（需先 npm install）：
#   node -e "console.log(require('bcryptjs').hashSync('你的管理员密码', 10))"
ADMIN_TOKEN_HASH=__REPLACE_WITH_BCRYPT_HASH__

# TOTP secret 的 AES-256-GCM 加密密钥，必须 64 位十六进制（32 字节）。
# 生成方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=__REPLACE_WITH_64_HEX_CHARS__

# 运行环境
NODE_ENV=production

# 信任反向代理跳数（默认 0 = 不信任，直连部署的 fail-safe 默认值）。
# 若部署在 Nginx / Cloudflare 等反向代理之后，必须显式设置，否则 IP 封锁与
# 限流会把所有请求记到代理 IP 上（误伤全体用户）：
#   Nginx 单层反代：TRUST_PROXY=1
#   多级代理按跳数递增（如 Nginx + CDN：TRUST_PROXY=2）
#TRUST_PROXY=0

# ── GET /api/version/region 的地理回读（T96，全部可选）────────────────────
# 这条接口只把**边缘**看到的国家码原样报给客户端（客户端据此在两台更新服务器间挑一台）。
# 它刻意不用 req.ip：`TRUST_PROXY=0` 时源站看到的 IP 是 CDN 回源 IP，拿它算地理会把
# Cloudflare 的机房当成用户（与 #140 是同一件事）。
#
# ⚠⚠ 2026-10-07 部署后实测（两台各一发，都带 `-H 'cf-ipcountry: US'`）：
#   · Cloudflare 那台（.top）：回的是真实结论（CN）—— 边缘**覆盖**入站的 cf-ipcountry；
#   · 腾讯 EdgeOne 那台（.com）：回的就是 US —— 客户端写什么就出什么，cf-* 被**原样透传**进源站。
#   源站只看得到一条头，分不出是谁写的 ⇒ 信任由下面这个变量声明，**没声明就一律不出结论**。
#
# 这台的网络里，地理头由边缘覆盖时才这么写（只有实测覆盖过的才写）：
#   FNTHINK_GEO_TRUST=cf        信任 cf-ipcountry
#   FNTHINK_GEO_TRUST=header    信任 FNTHINK_GEO_HEADER 那个头
#   FNTHINK_GEO_TRUST=cf,header 两个都信任
# 只认 cf / header 这两个词（大小写不限）；写成 1 / true / 整头名 都算没声明（fail-closed）。
# ⚠ 不声明也不会出错：接口回 country:null，客户端自动退回"只按实测时延挑一台"。
#FNTHINK_GEO_TRUST=
# Cloudflare 那台设了上面那行就够；EdgeOne 那台将来若实测到自己的地理头，两个一起设：
#   FNTHINK_GEO_HEADER=<头名>   自定义地理头（猜的头名只会让接口恒回 null，因为没人会替你声明信任它）
#   FNTHINK_EDGE=<边缘名>       边缘标识**只能**由这里声明（cf-* 谁都能写，不再拿来推断边缘）
#FNTHINK_GEO_HEADER=
#FNTHINK_EDGE=
# 临时仪器：设为 1 时该接口额外回**请求头的名字**列表（只有名字、不含值），
# 用来一次 curl 就问出 EdgeOne 到底带了什么头。**测完必须关掉** —— 它是排查用的，
# 不是常态接口的一部分。
#FNTHINK_GEO_ECHO=0

# 数据目录（默认 <server>/data）。存放 version.json / totp.json / sessions.json /
# blocked_ips.json / failed_attempts.json / rate_limit.json。
# ⚠ 部署时该目录**只属于服务器**：上传代码包不得覆盖它，否则 2FA secret 与恢复码哈希会丢
#   （= 管理后台自锁，只能删 totp.json 重新绑定）。
#DATA_DIR=/opt/update-server/data

# CORS 允许的来源，逗号分隔（默认空 = 不放行任何跨域来源，同源请求不受影响）。
# 例：ALLOWED_ORIGINS=https://notice.example.com,https://your-org.github.io
# 仅当你确实需要浏览器端跨域调用时才设置；填 * 会放开全部来源。
#ALLOWED_ORIGINS=

# 限流阈值（窗口内请求数上限，超限返回 429）。默认 60 / 5。
# 计数按「路由桶」而非精确路径：api-admin / api / static 三桶，内存计数 + 定期落盘。
#RATE_LIMIT_GENERAL_MAX=60
#RATE_LIMIT_AUTH_MAX=5

# 幻念推送（公网面 /api/fnthink/*）整个面的每 IP 每分钟上限，只当洪水闸用。
# ⚠ 各端点真正的额度不在这里配，而是从契约文件 protocol/fnthink-v1.json 的 limits 段读：
#   按 IP 的只有 register（30/分·3000/天），按设备地址的有配对三步与 /message（60/分·5000/天），
#   poll/ack 从 presence 的节奏推导（14/分、无日档）。要调它们就改契约（并把那份 JSON 一起上传）。
#RATE_LIMIT_FNTHINK_MAX=300

# 契约文件路径覆盖。默认规则：lib/fnthink 往上三级进 protocol/fnthink-v1.json，即"与代码目录
# 同级"（仓库里就是根目录那份）。**部署时建议显式写死**：算出来的位置随"server 内容放哪一级"而变，
# 放哪由你定，写死最不容易错。
# ⚠ 它不在 server/ 目录里，上传代码时要单独传一份（见 README「方案〇」第 1b 步）。
#FNTHINK_CONTRACT=<放契约的目录>/fnthink-v1.json

# 临时关闭 IP 封锁（仍累计失败次数，但不执行封锁/拦截）。仅排障用，勿长期开启。
# 取值 1 / true / yes 视为开启该开关。
#DISABLE_IP_BLOCKING=
